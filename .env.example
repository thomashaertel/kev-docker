# Model to serve (Hub ID, optionally with a revision, e.g. jaredpalmer/kev-4b@v1.0)
# Options: jaredpalmer/kev-0.8b | jaredpalmer/kev-4b | jaredpalmer/kev-9b | jaredpalmer/kev-27b
KEV_MODEL=jaredpalmer/kev-0.8b

# Host interface the published port binds to
# 127.0.0.1 = this machine only, 0.0.0.0 = reachable from the network
KEV_HOST=0.0.0.0

# Port exposed on the host
KEV_PORT=8009

# Bearer key required on /v1/* (generate with: openssl rand -hex 24)
KEV_API_KEY=change-me

